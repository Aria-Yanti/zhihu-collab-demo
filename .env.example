# Copy this file to .env.local for local configuration.
# Set DEMO_MODE=true to use deterministic local search data.
DEMO_MODE=true
# OAuth App ID (public identifier; OAuth login is not implemented in this demo yet)
ZHIHU_APP_ID=451
ZHIHU_OAUTH_APP_KEY=
ZHIHU_ACCESS_SECRET=
# Optional absolute path to the official Skill runner.
ZHIHU_SKILL_RUNNER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
